# Copy to .env. Every setting is optional; these are the defaults.
GRIDCARBON_DATA_ROOT=data
GRIDCARBON_DBT_PROJECT_DIR=dbt
GRIDCARBON_LOG_LEVEL=INFO
GRIDCARBON_LOG_JSON=0

# Serving database (leave unset to skip the Postgres load)
# GRIDCARBON_POSTGRES_DSN=postgresql://gridcarbon:gridcarbon@localhost:5432/gridcarbon
# GRIDCARBON_POSTGRES_SCHEMA=marts
# GRIDCARBON_API_BACKEND=duckdb   # or postgres

# Quality thresholds
GRIDCARBON_MIN_PERIODS_PER_DAY=44
GRIDCARBON_GENERATION_MIX_TOLERANCE_PCT=2.0

# HTTP
GRIDCARBON_HTTP_MAX_ATTEMPTS=5
GRIDCARBON_HTTP_TIMEOUT_SECONDS=30
